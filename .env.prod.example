# Copie para .env.prod no servidor e preencha antes de rodar
# deploy/vps-setup.sh. Nunca commite o .env.prod de verdade (já está no
# .gitignore).

# Senha do Postgres — gere algo forte, ex: openssl rand -hex 24
POSTGRES_PASSWORD="troque-por-uma-senha-forte"

# Segredo do JWT — gere algo forte, ex: openssl rand -hex 32
JWT_SECRET="troque-por-um-segredo-forte-gerado-aleatoriamente"

# IP (ou domínio, se tiver um) do servidor. SEM barra no final.
# PUBLIC_API_URL vira o VITE_API_URL do frontend (assado no build).
# PUBLIC_WEB_URL vira o CORS_ORIGIN da API.
PUBLIC_API_URL="http://SEU-IP:3000"
PUBLIC_WEB_URL="http://SEU-IP"

# Usadas SÓ na primeira execução do deploy/vps-setup.sh, pra criar o
# primeiro Administrador. Depois de rodar uma vez, pode apagar estas duas
# linhas do .env.prod — não são usadas por nenhum container em runtime.
ADMIN_BOOTSTRAP_EMAIL="seu-email@exemplo.com"
ADMIN_BOOTSTRAP_SENHA="escolha-uma-senha-forte"
